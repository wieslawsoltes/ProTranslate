<Project Sdk="Uno.Sdk/6.5.33">
  <PropertyGroup>
    <TargetFramework>net10.0-desktop</TargetFramework>
    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>
    <UnoFeatures>SkiaRenderer;</UnoFeatures>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/ProTranslate.Formats/ProTranslate.Formats.csproj" />
    <ProjectReference Include="../../src/ProTranslate.Uno/ProTranslate.Uno.csproj" />
    <ProjectReference Include="../../src/ProTranslate.SourceGenerator/ProTranslate.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="Resources/Strings.*.json" Link="Resources/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
