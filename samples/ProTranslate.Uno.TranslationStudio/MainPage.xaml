<Page x:Class="ProTranslate.Uno.TranslationStudio.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:ProTranslate.Uno.TranslationStudio">
  <Grid Background="{StaticResource StudioPageBackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="68" />
      <RowDefinition Height="*" />
      <RowDefinition Height="32" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Background="{StaticResource StudioSurfaceBrush}"
            BorderBrush="{StaticResource StudioBorderBrush}"
            BorderThickness="0,0,0,1">
      <Grid Padding="18,8" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{x:Bind ViewModel.Strings.AppTitle, Mode=OneWay}"
                     FontSize="18"
                     FontWeight="SemiBold" />
          <TextBlock Text="{x:Bind ViewModel.Strings.AppSubtitle, Mode=OneWay}"
                     FontSize="12"
                     Foreground="{StaticResource StudioMutedTextBrush}" />
        </StackPanel>

        <ComboBox Grid.Column="1"
                  Width="142"
                  Header="{x:Bind ViewModel.Strings.UiCultureLabel, Mode=OneWay}"
                  ItemsSource="{x:Bind ViewModel.UiCultures}"
                  SelectedItem="{x:Bind ViewModel.SelectedUiCulture, Mode=TwoWay}"
                  DisplayMemberPath="DisplayName" />

        <Button Grid.Column="2"
                Command="{x:Bind ViewModel.ImportDemoCommand}"
                VerticalAlignment="Bottom">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <FontIcon Glyph="&#xE8B5;" FontSize="14" />
            <TextBlock Text="{x:Bind ViewModel.Strings.ImportButton, Mode=OneWay}" />
          </StackPanel>
        </Button>

        <Button Grid.Column="3"
                Command="{x:Bind ViewModel.ExportCatalogCommand}"
                VerticalAlignment="Bottom">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <FontIcon Glyph="&#xE74E;" FontSize="14" />
            <TextBlock Text="{x:Bind ViewModel.Strings.ExportButton, Mode=OneWay}" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Padding="16" ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="312" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="332" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0"
              Background="{StaticResource StudioSurfaceBrush}"
              BorderBrush="{StaticResource StudioBorderBrush}"
              BorderThickness="1"
              CornerRadius="6">
        <ScrollViewer>
          <StackPanel Padding="14" Spacing="14">
            <TextBlock Text="{x:Bind ViewModel.Strings.CatalogLabel, Mode=OneWay}"
                       FontSize="15"
                       FontWeight="SemiBold" />

            <ComboBox Header="{x:Bind ViewModel.Strings.ImportFormatLabel, Mode=OneWay}"
                      ItemsSource="{x:Bind ViewModel.ImportFormats}"
                      SelectedItem="{x:Bind ViewModel.SelectedImportFormat, Mode=TwoWay}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="local:CatalogFormatChoice">
                  <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                      <TextBlock Text="{x:Bind Description}"
                                 FontSize="11"
                                 Foreground="{StaticResource StudioMutedTextBrush}"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Text="{x:Bind Extension}"
                               FontFamily="Consolas"
                               FontSize="11"
                               Foreground="{StaticResource StudioMutedTextBrush}"
                               VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>

            <ComboBox Header="{x:Bind ViewModel.Strings.TargetCultureLabel, Mode=OneWay}"
                      ItemsSource="{x:Bind ViewModel.TargetCultures}"
                      SelectedItem="{x:Bind ViewModel.SelectedTargetCulture, Mode=TwoWay}"
                      DisplayMemberPath="DisplayName" />

            <ComboBox Header="{x:Bind ViewModel.Strings.ExportFormatLabel, Mode=OneWay}"
                      ItemsSource="{x:Bind ViewModel.ExportFormats}"
                      SelectedItem="{x:Bind ViewModel.SelectedExportFormat, Mode=TwoWay}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="local:CatalogFormatChoice">
                  <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                      <TextBlock Text="{x:Bind Description}"
                                 FontSize="11"
                                 Foreground="{StaticResource StudioMutedTextBrush}"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Text="{x:Bind Extension}"
                               FontFamily="Consolas"
                               FontSize="11"
                               Foreground="{StaticResource StudioMutedTextBrush}"
                               VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>

            <Grid RowSpacing="8">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <TextBlock Text="{x:Bind ViewModel.Strings.EntriesLabel, Mode=OneWay}"
                         Foreground="{StaticResource StudioMutedTextBrush}" />
              <TextBlock Grid.Column="1"
                         Text="{x:Bind ViewModel.TotalCount, Mode=OneWay}"
                         FontWeight="SemiBold" />

              <TextBlock Grid.Row="1"
                         Text="{x:Bind ViewModel.Strings.ApprovedLabel, Mode=OneWay}"
                         Foreground="{StaticResource StudioMutedTextBrush}" />
              <TextBlock Grid.Row="1"
                         Grid.Column="1"
                         Text="{x:Bind ViewModel.ApprovedCount, Mode=OneWay}"
                         FontWeight="SemiBold" />

              <TextBlock Grid.Row="2"
                         Text="{x:Bind ViewModel.Strings.ReviewLabel, Mode=OneWay}"
                         Foreground="{StaticResource StudioMutedTextBrush}" />
              <TextBlock Grid.Row="2"
                         Grid.Column="1"
                         Text="{x:Bind ViewModel.ReviewCount, Mode=OneWay}"
                         FontWeight="SemiBold" />

              <TextBlock Grid.Row="3"
                         Text="{x:Bind ViewModel.Strings.MissingLabel, Mode=OneWay}"
                         Foreground="{StaticResource StudioMutedTextBrush}" />
              <TextBlock Grid.Row="3"
                         Grid.Column="1"
                         Text="{x:Bind ViewModel.MissingCount, Mode=OneWay}"
                         FontWeight="SemiBold" />
            </Grid>

            <StackPanel Spacing="6">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind ViewModel.Strings.CoverageLabel, Mode=OneWay}"
                           FontWeight="SemiBold" />
                <TextBlock Grid.Column="1"
                           Text="{x:Bind ViewModel.CoverageLabel, Mode=OneWay}"
                           Foreground="{StaticResource StudioAccentBrush}"
                           FontWeight="SemiBold" />
              </Grid>
              <ProgressBar Minimum="0"
                           Maximum="100"
                           Value="{x:Bind ViewModel.CoveragePercent, Mode=OneWay}" />
            </StackPanel>

            <ListView ItemsSource="{x:Bind ViewModel.Coverage}"
                      MaxHeight="160"
                      SelectionMode="None">
              <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:CultureCoverageViewModel">
                  <Grid ColumnSpacing="8" Padding="0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="54" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="{x:Bind DisplayName}" />
                      <TextBlock Text="{x:Bind CultureName}"
                                 FontSize="11"
                                 Foreground="{StaticResource StudioMutedTextBrush}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Text="{x:Bind CompletenessLabel}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold" />
                  </Grid>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>

            <Border BorderBrush="{StaticResource StudioBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10">
              <StackPanel Spacing="6">
                <TextBlock Text="{x:Bind ViewModel.Strings.GeneratorLabel, Mode=OneWay}"
                           FontWeight="SemiBold" />
                <TextBlock Text="{x:Bind ViewModel.Strings.GeneratorDescription, Mode=OneWay}"
                           Foreground="{StaticResource StudioMutedTextBrush}"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <Border Grid.Column="1"
              Background="{StaticResource StudioSurfaceBrush}"
              BorderBrush="{StaticResource StudioBorderBrush}"
              BorderThickness="1"
              CornerRadius="6">
        <Grid RowSpacing="0">
          <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Grid Padding="12,8" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind ViewModel.CatalogFileName, Mode=OneWay}"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold" />
            <TextBlock Grid.Column="1"
                       Text="{x:Bind ViewModel.CulturePair, Mode=OneWay}"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource StudioMutedTextBrush}" />
            <TextBlock Grid.Column="2"
                       Text="{x:Bind ViewModel.SourceFormat, Mode=OneWay}"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource StudioMutedTextBrush}" />
          </Grid>

          <Grid Grid.Row="1"
                Background="#EEF2F5"
                Padding="10,8"
                ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="220" />
              <ColumnDefinition Width="2*" />
              <ColumnDefinition Width="2*" />
              <ColumnDefinition Width="88" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Key" FontWeight="SemiBold" />
            <TextBlock Grid.Column="1"
                       Text="{x:Bind ViewModel.Strings.SourceLabel, Mode=OneWay}"
                       FontWeight="SemiBold" />
            <TextBlock Grid.Column="2"
                       Text="{x:Bind ViewModel.Strings.TargetLabel, Mode=OneWay}"
                       FontWeight="SemiBold" />
            <TextBlock Grid.Column="3"
                       Text="{x:Bind ViewModel.Strings.StateLabel, Mode=OneWay}"
                       FontWeight="SemiBold" />
          </Grid>

          <ListView Grid.Row="2"
                    ItemsSource="{x:Bind ViewModel.Entries}"
                    SelectedItem="{x:Bind ViewModel.SelectedEntry, Mode=TwoWay}"
                    SelectionMode="Single">
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="local:CatalogEntryViewModel">
                <Grid ColumnSpacing="8" Padding="10,7">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="88" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{x:Bind Key}"
                             TextTrimming="CharacterEllipsis"
                             FontFamily="Consolas" />
                  <TextBlock Grid.Column="1"
                             Text="{x:Bind SourceText}"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="2"
                             Text="{x:Bind TargetText, Mode=OneWay}"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="3"
                             Text="{x:Bind StateLabel, Mode=OneWay}"
                             FontWeight="SemiBold" />
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </Grid>
      </Border>

      <Border Grid.Column="2"
              Background="{StaticResource StudioSurfaceBrush}"
              BorderBrush="{StaticResource StudioBorderBrush}"
              BorderThickness="1"
              CornerRadius="6">
        <ScrollViewer>
          <StackPanel Padding="14" Spacing="12">
            <TextBlock Text="{x:Bind ViewModel.SelectedKey, Mode=OneWay}"
                       FontSize="15"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />
            <TextBlock Text="{x:Bind ViewModel.SelectedStateLabel, Mode=OneWay}"
                       Foreground="{StaticResource StudioAccentBrush}"
                       FontWeight="SemiBold" />

            <TextBox Header="{x:Bind ViewModel.Strings.SourceLabel, Mode=OneWay}"
                     Text="{x:Bind ViewModel.SelectedSourceText, Mode=OneWay}"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     MinHeight="74" />

            <TextBox Header="{x:Bind ViewModel.Strings.TargetLabel, Mode=OneWay}"
                     Text="{x:Bind ViewModel.SelectedTargetText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     MinHeight="86" />

            <TextBox Header="{x:Bind ViewModel.Strings.NotesLabel, Mode=OneWay}"
                     Text="{x:Bind ViewModel.SelectedNotes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     MinHeight="72" />

            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Button Command="{x:Bind ViewModel.ApproveSelectedCommand}"
                      HorizontalAlignment="Stretch">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <FontIcon Glyph="&#xE73E;" FontSize="14" />
                  <TextBlock Text="{x:Bind ViewModel.Strings.ApproveButton, Mode=OneWay}" />
                </StackPanel>
              </Button>
              <Button Grid.Column="1"
                      Command="{x:Bind ViewModel.MarkReviewCommand}"
                      HorizontalAlignment="Stretch">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <FontIcon Glyph="&#xE7BA;" FontSize="14" />
                  <TextBlock Text="{x:Bind ViewModel.Strings.ReviewButton, Mode=OneWay}" />
                </StackPanel>
              </Button>
            </Grid>

            <Border BorderBrush="{StaticResource StudioBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10">
              <StackPanel Spacing="6">
                <TextBlock Text="{x:Bind ViewModel.Strings.DiagnosticsLabel, Mode=OneWay}"
                           FontWeight="SemiBold" />
                <TextBlock Text="{x:Bind ViewModel.SelectedDiagnostics, Mode=OneWay}"
                           Foreground="{StaticResource StudioMutedTextBrush}"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border BorderBrush="{StaticResource StudioBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10">
              <StackPanel Spacing="6">
                <TextBlock Text="{x:Bind ViewModel.Strings.ServiceBoundaryLabel, Mode=OneWay}"
                           FontWeight="SemiBold" />
                <TextBlock Text="{x:Bind ViewModel.Strings.ServiceBoundaryDescription, Mode=OneWay}"
                           Foreground="{StaticResource StudioMutedTextBrush}"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <Border Grid.Row="2"
            Background="{StaticResource StudioSurfaceBrush}"
            BorderBrush="{StaticResource StudioBorderBrush}"
            BorderThickness="0,1,0,0">
      <Grid Padding="16,0">
        <TextBlock Text="{x:Bind ViewModel.LastExportSummary, Mode=OneWay}"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource StudioMutedTextBrush}" />
      </Grid>
    </Border>
  </Grid>
</Page>
