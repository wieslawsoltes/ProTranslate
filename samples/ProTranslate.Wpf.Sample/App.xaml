<Application x:Class="ProTranslate.Wpf.Sample.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <Style TargetType="TextBlock" x:Key="TitleText">
      <Setter Property="FontSize" Value="26" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#18202F" />
    </Style>
    <Style TargetType="TextBlock" x:Key="SectionText">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#18202F" />
    </Style>
    <Style TargetType="TextBlock" x:Key="CaptionText">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="#647086" />
    </Style>
    <Style TargetType="Border" x:Key="PanelBorder">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#D9E0EA" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="18" />
    </Style>
  </Application.Resources>
</Application>
