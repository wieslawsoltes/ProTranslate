<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-maccatalyst</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseMaui>true</UseMaui>
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
    <RootNamespace>ProTranslate.Maui</RootNamespace>
    <PackageId>ProTranslate.Maui</PackageId>
    <Title>ProTranslate.Maui</Title>
    <Description>.NET MAUI XAML adapter for ProTranslate dynamic translation, culture switching, and flow direction.</Description>
    <PackageTags>MAUI;XAML;Localization;Globalization;Translation</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Maui.Controls" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ProTranslate.Abstractions/ProTranslate.Abstractions.csproj" />
    <ProjectReference Include="../ProTranslate.Core/ProTranslate.Core.csproj" />
  </ItemGroup>
</Project>
