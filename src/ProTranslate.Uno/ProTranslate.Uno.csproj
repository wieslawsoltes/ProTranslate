<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ProTranslate.Uno</RootNamespace>
    <PackageId>ProTranslate.Uno</PackageId>
    <Title>ProTranslate.Uno</Title>
    <Description>Uno Platform XAML adapter for ProTranslate dynamic translation, culture switching, and WinUI-compatible bindings.</Description>
    <PackageTags>Uno;WinUI;XAML;Localization;Globalization;Translation</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Uno.WinUI" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ProTranslate.Abstractions/ProTranslate.Abstractions.csproj" />
    <ProjectReference Include="../ProTranslate.Core/ProTranslate.Core.csproj" />
  </ItemGroup>
</Project>
