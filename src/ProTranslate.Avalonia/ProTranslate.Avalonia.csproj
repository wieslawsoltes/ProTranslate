<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ProTranslate.Avalonia</RootNamespace>
    <PackageId>ProTranslate.Avalonia</PackageId>
    <Title>ProTranslate.Avalonia</Title>
    <Description>Avalonia XAML adapter for ProTranslate dynamic translation, culture switching, and flow direction.</Description>
    <PackageTags>Avalonia;XAML;Localization;Globalization;Translation</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ProTranslate.Abstractions/ProTranslate.Abstractions.csproj" />
    <ProjectReference Include="../ProTranslate.Core/ProTranslate.Core.csproj" />
  </ItemGroup>
</Project>
